{
  "name": "@menzies-mariesta-com/menzies-design-wash-ui",
  "version": "0.3.0",
  "description": "Menzies Design Wash UI: framework-free core (CSS, themes) plus optional React adapter",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "repository": "https://github.com/menzies-mariesta-com/wash-ui-design-lib-menzies.git",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js"
    },
    "./icons/brands": {
      "types": "./dist/icons/brands/index.d.ts",
      "import": "./dist/icons/brands/index.js"
    },
    "./icons/brands/catalog": {
      "types": "./dist/icons/brands/catalog-entry.d.ts",
      "import": "./dist/icons/brands/catalog-entry.js"
    },
    "./charts": {
      "types": "./dist/charts/index.d.ts",
      "import": "./dist/charts/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:css": "vite build --config vite.css.config.ts",
    "build:js": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "build": "npm run build:css && npm run build:js && node ./scripts/postbuild.mjs",
    "dev": "vite build --watch"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "apexcharts": "^5.16.0",
    "lucide-react": "1.28.0",
    "react-apexcharts": "^2.1.1",
    "simple-icons": "^15.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "daisyui": "5.7.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^4.5.4"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
