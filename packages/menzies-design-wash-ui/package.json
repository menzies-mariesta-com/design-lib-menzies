{
  "name": "@menzies-mariesta-com/menzies-design-wash-ui",
  "version": "1.7.0",
  "description": "Menzies Design Wash UI: framework-free core (CSS, themes) plus optional React adapter",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/menzies-mariesta-com/design-lib-menzies.git",
    "directory": "packages/menzies-design-wash-ui"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "NOTICE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js"
    },
    "./icons/brands": {
      "types": "./dist/icons/brands/index.d.ts",
      "import": "./dist/icons/brands/index.js"
    },
    "./icons/brands/catalog": {
      "types": "./dist/icons/brands/catalog-entry.d.ts",
      "import": "./dist/icons/brands/catalog-entry.js"
    },
    "./charts": {
      "types": "./dist/charts/index.d.ts",
      "import": "./dist/charts/index.js"
    },
    "./charts/apex": {
      "types": "./dist/charts/apex.d.ts",
      "import": "./dist/charts/apex.js"
    },
    "./editors": {
      "types": "./dist/editors/index.d.ts",
      "import": "./dist/editors/index.js"
    },
    "./splash": {
      "types": "./dist/splash/index.d.ts",
      "import": "./dist/splash/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:css": "vite build --config vite.css.config.ts",
    "build:js": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "build": "rm -rf dist && npm run build:css && npm run build:js && node ./scripts/postbuild.mjs",
    "test": "vitest run",
    "smoke:import": "node ./scripts/smoke-import.mjs",
    "generate:daisy-inventory": "node ./scripts/generate-daisy-inventory.mjs",
    "dev": "vite build --watch"
  },
  "peerDependencies": {
    "@ui-sdk/core": "^0.1.0-beta.12",
    "@ui-sdk/react": "^0.1.0-beta.12",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@ui-sdk/core": {
      "optional": true
    },
    "@ui-sdk/react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "apexcharts": "^5.16.0",
    "lucide-react": "1.28.0",
    "react-apexcharts": "^2.1.1",
    "simple-icons": "^15.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.3.0",
    "@ui-sdk/core": "^0.1.0-beta.12",
    "@ui-sdk/react": "^0.1.0-beta.12",
    "daisyui": "5.7.9",
    "jsdom": "^27.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^4.5.4"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
